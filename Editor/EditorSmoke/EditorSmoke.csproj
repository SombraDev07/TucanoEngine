<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EditorSmoke</AssemblyName>
    <RootNamespace>EditorSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EditorCore\EditorCore.csproj" />
  </ItemGroup>

  <!-- Same native deploy step the editor uses: without the DLL beside the exe, P/Invoke throws. -->
  <PropertyGroup>
    <TucanoNativeDir Condition="'$(TucanoNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-release\src</TucanoNativeDir>
  </PropertyGroup>

  <Target Name="CopyTucanoNative" AfterTargets="Build">
    <ItemGroup>
      <TucanoNativeFiles Include="$(TucanoNativeDir)\TucanoEditorAPI.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TucanoNativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TucanoNativeDir)\TucanoEditorAPI.dll')" />
  </Target>

</Project>
