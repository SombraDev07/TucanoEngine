<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--  TUCANO EDITOR — Black + Gold Control Theme  -->
    <!-- ═══════════════════════════════════════════ -->

    <Styles.Resources>
        <!-- ── Toco toucan (Ramphastos toco) ──
             Jet-black plumage, amber bill with a dark tip, white throat bib, blue eye-ring.
             The bill amber is the single accent; the eye-ring blue is reserved for information
             and the bill-tip red for destructive actions, so nothing else competes with it. -->

        <!-- Bill: the accent -->
        <SolidColorBrush x:Key="Gold" Color="#F2A81D" />
        <SolidColorBrush x:Key="GoldBright" Color="#FFC94A" />
        <SolidColorBrush x:Key="GoldDim" Color="#C57F00" />
        <SolidColorBrush x:Key="GoldDark" Color="#7A4E00" />
        <SolidColorBrush x:Key="GoldFaint" Color="#1C1508" />
        <SolidColorBrush x:Key="GoldGlow" Color="#2E210A" />

        <!-- Plumage: surfaces, near-black with a warm cast rather than blue-grey -->
        <SolidColorBrush x:Key="Root" Color="#08080A" />
        <SolidColorBrush x:Key="Panel" Color="#0F0F12" />
        <SolidColorBrush x:Key="Header" Color="#15151A" />
        <SolidColorBrush x:Key="Card" Color="#191920" />
        <SolidColorBrush x:Key="Input" Color="#111116" />
        <SolidColorBrush x:Key="Hover" Color="#22222A" />
        <SolidColorBrush x:Key="Active" Color="#2C2C36" />
        <SolidColorBrush x:Key="Chrome" Color="#0C0C0F" />

        <!-- Borders -->
        <SolidColorBrush x:Key="Line" Color="#24242D" />
        <SolidColorBrush x:Key="LineSoft" Color="#1A1A21" />
        <SolidColorBrush x:Key="LineGold" Color="#3A2C10" />

        <!-- Throat bib: text -->
        <SolidColorBrush x:Key="Text" Color="#F2EFE6" />
        <SolidColorBrush x:Key="TextSub" Color="#9A9AA4" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B6B75" />
        <SolidColorBrush x:Key="TextGold" Color="#FFC94A" />

        <!-- Bill tip / eye ring -->
        <SolidColorBrush x:Key="Danger" Color="#D94F2B" />
        <SolidColorBrush x:Key="Info" Color="#4E8FC4" />
        <SolidColorBrush x:Key="Good" Color="#5FBF66" />

        <!-- Semantic axes -->
        <SolidColorBrush x:Key="X" Color="#D94F2B" />
        <SolidColorBrush x:Key="Y" Color="#5FBF66" />
        <SolidColorBrush x:Key="Z" Color="#4E8FC4" />

    </Styles.Resources>

    <!-- ═══ GLOBAL ═══ -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Root}" />
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, sans-serif" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══ BUTTON ═══ -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource GoldBright}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource GoldFaint}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
    </Style>

    <!-- Toolbar buttons -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- Transport buttons (▶ ⏸ ⏹) -->
    <Style Selector="Button.transport">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource GoldFaint}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
    </Style>

    <!-- Primary action button -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource GoldDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Gold}" />
        <Setter Property="Foreground" Value="#0A0A0E" />
    </Style>

    <!-- ═══ TEXTBOX ═══ -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Input}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GoldDark}" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
    </Style>

    <!-- ═══ COMBOBOX ═══ -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource Input}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
    </Style>

    <!-- ═══ CHECKBOX ═══ -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══ SLIDER ═══ -->
    <Style Selector="Slider /template/ Border#PART_TrackBackground">
        <Setter Property="Background" Value="{StaticResource Card}" />
    </Style>
    <Style Selector="Slider /template/ Border#PART_SelectionRange">
        <Setter Property="Background" Value="{StaticResource Gold}" />
    </Style>

    <!-- ═══ TREE ═══ -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{StaticResource Hover}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{StaticResource GoldGlow}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
    </Style>

    <!-- ═══ LIST ═══ -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Hover}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource GoldGlow}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
    </Style>

    <!-- ═══ TABS ═══ -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabStrip">
        <Setter Property="Background" Value="{StaticResource Root}" />
    </Style>
    <Style Selector="TabStripItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TabStripItem:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
    </Style>
    <Style Selector="TabStripItem:selected">
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ═══ MENU ═══ -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{StaticResource Header}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_Popup">
        <Setter Property="Background" Value="{StaticResource Header}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <!-- ═══ EXPANDER ═══ -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,3" />
    </Style>
    <Style Selector="Expander:pointerover /template/ ToggleButton#PART_Header">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ═══ SCROLLBAR ═══ -->
    <Style Selector="ScrollBar /template/ Thumb#PART_Thumb">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb#PART_Thumb">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource GoldDim}" />
    </Style>

    <!-- ═══ SPLITTER ═══ -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{StaticResource LineSoft}" />
    </Style>

    <!-- ═══ PROGRESS ═══ -->
    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- ═══ TOOLTIP ═══ -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ═══ SEPARATOR ═══ -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource LineSoft}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- ═══ NUMERIC UPDOWN ═══ -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{StaticResource Input}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- ═══ CLASS STYLES ═══ -->

    <!-- Inspector section header -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextGold}" />
        <Setter Property="LetterSpacing" Value="0.5" />
    </Style>

    <!-- Row label for property names -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Width" Value="56" />
    </Style>

    <!-- Axis label (X/Y/Z) -->
    <Style Selector="TextBlock.axis">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Dim / muted text -->
    <Style Selector="TextBlock.dim">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- Header title -->
    <Style Selector="TextBlock.h">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        <Setter Property="LetterSpacing" Value="0.3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card container -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineGold}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Panel container -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Section header bar -->
    <Style Selector="Border.header">
        <Setter Property="Background" Value="{StaticResource Header}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- Icon path -->
    <Style Selector="Path.ico">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{StaticResource TextSub}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Chrome: the two header rows ═══ -->

    <!-- Top strip: menu on the left, live stats on the right. Deliberately darker than the
         command row below it so the window reads as two bands rather than one tall slab. -->
    <Style Selector="Border.chrome">
        <Setter Property="Background" Value="{StaticResource Chrome}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Command row -->
    <Style Selector="Border.commandbar">
        <Setter Property="Background" Value="{StaticResource Header}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- A group of related commands, boxed so the row scans as clusters instead of one long
         undifferentiated strip of buttons. -->
    <Style Selector="Border.cluster">
        <Setter Property="Background" Value="{StaticResource Chrome}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Strip directly above the 3D image, holding the controls that act on it. Sits between the
         amber keel and the viewport, so it is deliberately darker than the command row: the eye
         should read it as part of the viewport, not as a second toolbar. -->
    <Style Selector="Border.viewportbar">
        <Setter Property="Background" Value="{StaticResource Chrome}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!-- Live numeric readout in the top strip -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{StaticResource GoldFaint}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineGold}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.badge">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextGold}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The amber keel-line under the toolbar: the one piece of pure bill colour in the chrome. -->
    <Style Selector="Border.keel">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource Gold}" />
    </Style>

    <!-- Destructive action -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

</Styles>
