<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TucanoEditor.Views.WorldOutlinerWindow"
        Title="World Outliner"
        Width="380" Height="600"
        MinWidth="320" MinHeight="400"
        Background="#0B0B0D"
        Foreground="#E8E8EC"
        FontFamily="Segoe UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="header" Height="38">
            <TextBlock Text="WORLD OUTLINER" Classes="h" Margin="14,0"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer>
            <StackPanel Margin="10" Spacing="10">

                <!-- Start/Stop -->
                <Border Classes="card">
                    <StackPanel Spacing="4" Margin="8">
                        <TextBlock Text="STREAMING" Classes="section" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Extent:" Width="44" VerticalAlignment="Center" Classes="dim" />
                            <TextBox Name="ExtentBox" Text="6" Width="50" Classes="input" />
                            <TextBlock Text="Radius:" Width="44" VerticalAlignment="Center" Classes="dim" />
                            <TextBox Name="RadiusBox" Text="200" Width="50" Classes="input" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Button Name="StartBtn" Content="Start Streaming" Click="OnStartStream"
                                    Classes="accent" Height="28" />
                            <Button Name="StopBtn" Content="Stop" Click="OnStopStream"
                                    Height="28" Background="#442020" Foreground="#E5534B"
                                    IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border Classes="card">
                    <StackPanel Spacing="2" Margin="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="STATS" Classes="section" />
                            <Button Content="Refresh" Click="OnRefresh"
                                    Height="22" Width="55" FontSize="10"
                                    Background="#2A2A35" Foreground="#AAAAB4" />
                        </StackPanel>
                        <TextBlock Name="StatsText" Text="Streaming inactive"
                                   Classes="dim" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Cell List -->
                <Border Classes="card">
                    <StackPanel Spacing="4" Margin="8">
                        <TextBlock Text="RESIDENT CELLS" Classes="section" />
                        <TextBlock Name="CellCount" Text="0 cells" Classes="dim" FontSize="11" />
                        <ListBox Name="CellList" Height="260"
                                 Background="#14141A"
                                 BorderBrush="#2A2A31"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
