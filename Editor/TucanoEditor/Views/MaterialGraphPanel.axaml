<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TucanoEditor.Views.MaterialGraphPanel"
             Background="#111116"
             Foreground="#D0D0D8"
             FontFamily="Segoe UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="42" Background="#18181E"
                BorderBrush="#2A2A32" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Name="TitleLabel" Text="MATERIAL EDITOR" FontSize="13" FontWeight="Bold"
                               Foreground="#E8E8EC" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="#333340" Margin="6,0" />
                    <Button Content="Apply" Click="OnCompile" Classes="accent" Width="64"
                            Height="28" FontSize="12" />
                    <Button Content="Save" Click="OnSave" Width="56"
                            Height="28" FontSize="12" Background="#2A2A35" Foreground="#AAAAB4" />
                    <TextBlock Text="MMB / RMB pan · Wheel zoom · Space+drag pan"
                               FontSize="10" Foreground="#555560" VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Name="CompileStatus" Text="" FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Content="Fit" Width="40" Height="28" FontSize="11"
                            Background="#2A2A35" Foreground="#AAAAB4" Click="OnFitView"
                            ToolTip.Tip="Fit graph in view" />
                    <Button Content="✕ Back to Scene" Height="28" FontSize="11" Padding="10,0"
                            Background="#2A2A35" Foreground="#AAAAB4"
                            ToolTip.Tip="Leave material editor (Esc)"
                            Click="OnClose" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="240,*,280">
            <!-- LEFT: material-only tools -->
            <Border Grid.Column="0" Background="#15151A"
                    BorderBrush="#2A2A32" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Spacing="0">
                        <Border Padding="12,10" BorderBrush="#2A2A32" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="PALETTE" FontSize="10" FontWeight="Bold"
                                           Foreground="#666680" />
                                <Button Content="Constant (RGB)" Click="OnAddConstant3"
                                        Background="#1F3828" Foreground="#6EBD80"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                                <Button Content="Scalar" Click="OnAddConstant1"
                                        Background="#1F3828" Foreground="#6EBD80"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                                <Button Content="Multiply" Click="OnAddMultiply"
                                        Background="#1A2840" Foreground="#6EA0D4"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                                <Button Content="Add" Click="OnAddAdd"
                                        Background="#1A2840" Foreground="#6EA0D4"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                                <Button Content="Lerp" Click="OnAddLerp"
                                        Background="#1A2840" Foreground="#6EA0D4"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                                <Button Content="Texture Sample" Click="OnAddTexture"
                                        Background="#381E20" Foreground="#D4706E"
                                        BorderThickness="0" Height="28" FontSize="11" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <Border Padding="10,10" BorderBrush="#2A2A32" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="TEXTURES" FontSize="10" FontWeight="Bold"
                                           Foreground="#666680" />
                                <TextBlock Text="Folders · drag a texture onto the graph · Ctrl+Z undo"
                                           FontSize="10" Foreground="#444450" TextWrapping="Wrap" />

                                <TreeView Name="TextureFolderTree" MaxHeight="160"
                                          SelectionChanged="OnTextureFolderTreeChanged"
                                          Background="#121218" BorderBrush="#2A2A32" BorderThickness="1">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                                <Path Width="13" Height="13" Stretch="Uniform"
                                                      Data="{StaticResource IcoFolder}"
                                                      Stroke="#FFC107" StrokeThickness="1.3"
                                                      Fill="Transparent"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           Foreground="#D0D0D8"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountLabel}" FontSize="10"
                                                           Foreground="#555560"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <ItemsControl Name="TextureGrid" MaxHeight="260">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Margin="2" Padding="4"
                                                    Background="#1A1A22" CornerRadius="4"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{Binding Path}"
                                                    PointerPressed="OnTextureCardPressed"
                                                    PointerMoved="OnTextureCardMoved"
                                                    PointerReleased="OnTextureCardReleased"
                                                    PointerCaptureLost="OnTextureCardCaptureLost"
                                                    DoubleTapped="OnTextureCardDoubleTapped">
                                                <StackPanel Spacing="4">
                                                    <Border Width="92" Height="64" CornerRadius="3"
                                                            Background="#0E0E14" ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                                               Foreground="#C8C8D0"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="GRAPH" FontSize="10" FontWeight="Bold"
                                           Foreground="#555560" />
                                <TextBlock Name="StatsText" Text="Nodes: 0"
                                           FontSize="11" Foreground="#444450" />
                                <TextBlock Name="ZoomText" Text="Zoom 100%"
                                           FontSize="11" Foreground="#444450" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: infinite graph -->
            <Border Grid.Column="1" Background="#101014" ClipToBounds="True"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnGraphDragOver"
                    DragDrop.Drop="OnGraphDrop">
                <Canvas Name="GraphPanel" Background="#101014"
                        Focusable="True"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnGraphDragOver"
                        DragDrop.Drop="OnGraphDrop"
                        PointerPressed="OnCanvasPressed"
                        PointerMoved="OnCanvasMoved"
                        PointerReleased="OnCanvasReleased"
                        PointerWheelChanged="OnCanvasWheel" />
            </Border>

            <!-- RIGHT: preview + selected node -->
            <Border Grid.Column="2" Background="#15151A"
                    BorderBrush="#2A2A32" BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="0">
                        <Border Padding="12,10" BorderBrush="#2A2A32" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="MATERIAL PREVIEW" FontSize="10" FontWeight="Bold"
                                           Foreground="#666680" />
                                <Border Width="248" Height="248"
                                        CornerRadius="8" Background="#0A0A10"
                                        HorizontalAlignment="Center" ClipToBounds="True"
                                        BorderBrush="#2A2A32" BorderThickness="1">
                                    <Image Name="PreviewSphere" Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Name="PreviewInfo" Text="—"
                                           FontSize="11" Foreground="#555560"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12,10">
                            <StackPanel Name="DetailsPanel" Spacing="8">
                                <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold"
                                           Foreground="#666680" />
                                <TextBlock Name="DetailsHint" Text="Select a node"
                                           FontSize="11" Foreground="#555560" TextWrapping="Wrap" />
                                <TextBlock Name="DetailsTitle" Text="" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#E8E8EC" />
                                <Border Name="DetailsSwatch" Height="72" CornerRadius="6"
                                        Background="#22222A" BorderBrush="#333340"
                                        BorderThickness="1" ClipToBounds="True"
                                        IsVisible="False">
                                    <Image Name="DetailsImage" Stretch="UniformToFill"
                                           IsVisible="False" />
                                </Border>
                                <TextBox Name="DetailsValueBox" Watermark="value"
                                         IsVisible="False" FontSize="12"
                                         LostFocus="OnDetailsValueCommit"
                                         KeyDown="OnDetailsValueKey" />
                                <Button Name="BrowseTextureBtn" Content="Browse Texture…"
                                        IsVisible="False" Height="28" FontSize="11"
                                        Background="#2A2A35" Foreground="#AAAAB4"
                                        Click="OnBrowseTexture" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
