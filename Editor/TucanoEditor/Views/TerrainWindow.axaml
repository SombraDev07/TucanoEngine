<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TucanoEditor.Views.TerrainWindow"
        Title="Terrain Sculpt"
        Width="320" Height="500"
        MinWidth="280" MinHeight="400"
        Background="#0B0B0D"
        Foreground="#E8E8EC"
        FontFamily="Segoe UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="header" Height="38">
            <TextBlock Text="TERRAIN SCULPT" Classes="h" Margin="14,0"
                       VerticalAlignment="Center" />
        </Border>

        <ScrollViewer>
            <StackPanel Margin="10" Spacing="10">

                <!-- Generate -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GENERATE" Classes="section" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Res:" Width="34" VerticalAlignment="Center" Classes="dim" />
                            <TextBox Name="GenRes" Text="512" Width="72"
                                     Classes="input" />
                            <TextBlock Text="Size:" Width="34" VerticalAlignment="Center" Classes="dim" />
                            <TextBox Name="GenSize" Text="1024" Width="72"
                                     Classes="input" />
                        </StackPanel>
                        <Button Content="Generate Terrain" Click="OnGenerate"
                                Classes="primary" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Sculpt tools -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="BRUSH" Classes="section" />
                        <ComboBox Name="BrushTool" SelectedIndex="0"
                                  SelectionChanged="OnBrushChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Raise" />
                            <ComboBoxItem Content="Lower" />
                            <ComboBoxItem Content="Smooth" />
                            <ComboBoxItem Content="Flatten" />
                            <ComboBoxItem Content="Noise" />
                        </ComboBox>
                        <TextBlock Text="Radius" Classes="label" />
                        <Slider Name="BrushRadius" Minimum="2" Maximum="100" Value="20"
                                ValueChanged="OnBrushSlider" />
                        <TextBlock Name="RadiusValue" Text="20" Classes="dim" />
                        <TextBlock Text="Strength" Classes="label" />
                        <Slider Name="BrushStrength" Minimum="1" Maximum="50" Value="15"
                                ValueChanged="OnBrushSlider" />
                        <TextBlock Name="StrengthValue" Text="15" Classes="dim" />
                        <TextBlock Text="LMB on terrain to sculpt" Classes="dim"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Undo/Redo -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="HISTORY" Classes="section" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Undo" Click="OnUndo" Classes="tool"
                                    Width="60" Height="28" />
                            <Button Content="Redo" Click="OnRedo" Classes="tool"
                                    Width="60" Height="28" />
                            <TextBlock Name="UndoCount" Text="0/0" VerticalAlignment="Center"
                                       Classes="dim" />
                        </StackPanel>
                        <TextBlock Text="Ctrl+Z = Undo | Ctrl+Shift+Z = Redo"
                                   Classes="dim" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Erosion -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="EROSION" Classes="section" />
                        <Button Content="Erode (50k)" Click="OnErode"
                                Classes="tool" Height="28" />
                        <Button Content="Thermal Erode" Click="OnThermalErode"
                                Classes="tool" Height="28" />
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock Text="INFO" Classes="section" />
                        <TextBlock Name="TerrainInfo" Text="No terrain loaded"
                                   Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Export -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="EXPORT" Classes="section" />
                        <Button Content="Export .htmap" Click="OnExport"
                                Classes="tool" Height="28" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
