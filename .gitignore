# Build & IDE
/build/
/out/
/.vs/
/.idea/
/cache/
CMakeUserPresets.json
*.user
*.pdb
*.ilk
*.suo
*.VC.db

# Captures / local screenshots
/captures/*.png
!/captures/.gitkeep

# Third-party engine trees (reference only — never ship)
/DagorEngine/
/Esoterica-main/
/B3DFramework-master/
/-CRYENGINE-Community-Edition--main/
/-CRYENGINE*/
/CRYENGINE*/

# Roadmap files (local planning — not shipped)
/ROADMAP*.md
/LandscapeRoadmap.md
/roadmapIso.md
/docs/MASTER_ROADMAP.md
/docs/ROADMAP_VEGETACAO.md

# Proprietary / large SDKs in 3thirdy (keep READMEs + scripts)
/3thirdy/nsight-aftermath/**
!/3thirdy/nsight-aftermath/README.md
!/3thirdy/nsight-aftermath/.gitkeep
/3thirdy/nsight-aftermath-samples/
/3thirdy/_incoming/
/3thirdy/**/*.lib
/3thirdy/**/*.dll
/3thirdy/**/*.pdb
/3thirdy/**/*.exe


# Large / regenerable content
/Assets/Sponza/
/Assets/_gltf_tmp/
/Assets/sponza.zip
*.tif
*.TIF

# Runtime caches
/cache/dx12_pso.cache
*.cache

/captures/*.txt
/captures/*.dot

# Editor / generated files
/imgui.ini
/lua_log.txt
/NodeEditor.json
/NUL.obj
EditorLayout.ini

# Screenshots / debug images (root only)
/*.png
/editor_stream_world/
/world_lab/

# Dagor reference docs (local)
/docs/DAGOR_PARITY.md

# Local vcpkg clone
/Tools/vcpkg/

# Reflector compile arguments — generated at configure time from this machine's MSVC and Windows
# SDK paths. The template (compile_args.txt.in) is what belongs in the repo.
/Tools/Reflector/compile_args.txt

# TestPlay deploy (keep README; ignore built binaries / shaders)
/TestPlay/*.exe
/TestPlay/*.dll
/TestPlay/*.pdb
/TestPlay/shaders/
/TestPlay/*.png
!/TestPlay/README.md
!/TestPlay/.gitkeep

