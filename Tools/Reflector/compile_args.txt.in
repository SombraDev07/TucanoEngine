-x
c++
-std=c++20
-DTUCANO_REFLECTOR=1
-fms-compatibility
-fms-extensions
-fdelayed-template-parsing
-fms-compatibility-version=19.44
-nostdinc
-nostdinc++
-isystem
@TUCANO_MSVC_INCLUDE@
-isystem
@TUCANO_SDK_INCLUDE@/ucrt
-isystem
@TUCANO_SDK_INCLUDE@/um
-isystem
@TUCANO_SDK_INCLUDE@/shared
-I@CMAKE_SOURCE_DIR@/src
-I@glm_SOURCE_DIR@
-I@joltphysics_SOURCE_DIR@
-D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH
-DNOMINMAX
-DWIN32_LEAN_AND_MEAN
-DGLM_FORCE_DEPTH_ZERO_TO_ONE
-DGLM_FORCE_LEFT_HANDED
